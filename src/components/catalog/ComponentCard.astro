---
interface Props {
  name: string;
  description: string;
  href: string;
  meta?: string;
}
const { name, description, href, meta = 'Plantilla' } = Astro.props;
---
<a href={href} class="template-card">
  <div class="template-card__thumb" aria-hidden="true">
    <span class="template-card__stage"></span>
    <span class="template-card__panel"></span>
    <span class="template-card__caption"></span>
  </div>
  <div class="template-card__body">
    <div class="template-card__row">
      <h3 class="template-card__name">{name}</h3>
      <span class="template-card__meta">{meta}</span>
    </div>
    <p class="template-card__desc">{description}</p>
  </div>
</a>

<style lang="scss" is:global>
  /* Hallmark · genre: modern-minimal · design-system: design.md · designed-as-app */
  .template-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    transition:
      border-color var(--dur-micro) var(--ease-out),
      box-shadow var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out),
      background var(--dur-micro) var(--ease-out);

    &:hover {
      border-color: var(--color-rule-2);
      background: var(--color-paper-3);
      box-shadow: var(--shadow-lift);
      transform: translateY(-2px);
    }

    &:active {
      transform: translateY(0);
    }

    &:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }

    &__thumb {
      position: relative;
      height: 156px;
      background:
        radial-gradient(ellipse at 30% 20%, var(--home-glow), transparent 55%),
        linear-gradient(160deg, var(--color-paper-3), var(--color-paper-2));
      overflow: hidden;
      border-bottom: var(--rule-hair) solid var(--color-rule);
    }

    &__stage {
      position: absolute;
      inset: 18% 12% 22%;
      border-radius: 8px;
      background: linear-gradient(
        135deg,
        color-mix(in oklch, var(--color-accent) 28%, var(--color-paper-2)),
        color-mix(in oklch, var(--color-accent) 8%, var(--color-paper-3))
      );
      box-shadow: var(--shadow-soft);
    }

    &__panel {
      position: absolute;
      top: 28%;
      right: 16%;
      width: 38%;
      height: 42%;
      border-radius: 6px;
      background: color-mix(in oklch, var(--color-paper) 72%, transparent);
      border: var(--rule-hair) solid color-mix(in oklch, var(--color-ink) 10%, transparent);
      backdrop-filter: blur(6px);
    }

    &__caption {
      position: absolute;
      left: 18%;
      bottom: 18%;
      width: 28%;
      height: 8px;
      border-radius: 999px;
      background: color-mix(in oklch, var(--color-ink) 18%, transparent);
    }

    &__body {
      padding: var(--space-sm) var(--space-sm) var(--space-md);
    }

    &__row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-2xs);
      margin-bottom: 6px;
    }

    &__name {
      font-size: var(--text-lg);
      font-weight: 600;
      font-style: normal;
      letter-spacing: -0.02em;
    }

    &__meta {
      flex-shrink: 0;
      font-size: var(--text-xs);
      font-weight: 500;
      color: var(--color-muted);
    }

    &__desc {
      font-size: var(--text-sm);
      line-height: 1.45;
      color: var(--color-ink-2);
    }
  }
</style>
